+// PrepareDownloadDirectory does not recreate an unavailable user-selected
+// directory, which could otherwise write to the system disk after an eject.
+func PrepareDownloadDirectory(directory string) error {
+	if os.Getenv("KTAKE_MUSIC_DL_DIRECTORY_FILE") != "" && filepath.IsAbs(directory) {
+		info, err := os.Stat(directory)
+		if err != nil || !info.IsDir() {
+			return errors.New("无法访问所选下载目录，请连接外置硬盘或在 KTake 设置中选择其他文件夹")
+		}
+		return nil
+	}
+	return os.MkdirAll(directory, 0755)
+}
